# Ignore virtual environment
venv/
.venv/

# Ignore Python cache and compiled files
__pycache__/
*.pyc
*.pyo
*.pyd

# Ignore environment variables and secrets
.env
*.env

# Ignore IDE/project files
.vscode/
.idea/
*.swp

# Ignore logs and temporary files
*.log
*.tmp

# Ignore OS-specific files
.DS_Store
Thumbs.db

# Ignore Jupyter notebook checkpoints (if you use notebooks)
.ipynb_checkpoints/

# Ignore pipenv or poetry stuff if you ever use them
Pipfile.lock
poetry.lock

# Ignore coverage or testing outputs
.coverage
htmlcov/
.pytest_cache/
